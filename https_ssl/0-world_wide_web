#!/usr/bin/env bash
# Displays information about the subdomains of a domain
display_info () {
    line=$(dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1)
    echo "$2 $line" | awk '{print "The subdomain " $1 " is a " $5 " record and points to " $6}'
}
if [ "$#" -eq 1 ]
then
    for sub in www lb-01 web-01 web-02
    do
        display_info "$1" "$sub"
    done
else
    display_info "$1" "$2"
fi
